<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".XOneApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="ArcheOne"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XOne"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- Splash activity (no launcher intent) -->
        <activity
            android:name=".ui.screens.SplashActivity"
            android:theme="@style/Theme.XOne.Splash"
            android:exported="true"/>

        <!-- Launcher alias for default icon -->
        <activity-alias
            android:name="com.archeGlobal.one.SplashAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="ArcheOne"
            android:targetActivity=".ui.screens.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher alias for Pride icon (initially disabled) -->
        <activity-alias
            android:name="com.archeGlobal.one.SplashAliasPride"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/archepride"
            android:label="ArcheOne"
            android:targetActivity=".ui.screens.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


        <!-- OnboardingActivity -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.XOne">
        </activity>
        
        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.XOne">
        </activity>

        <!-- Add LoginActivity -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Login"
            android:theme="@style/Theme.XOne">
        </activity>

        <!-- OTP Verification Activity -->
        <activity
            android:name=".OtpVerificationActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="OTP Verification"
            android:theme="@style/Theme.XOne">
        </activity>

        <!-- My Documents Activity -->
        <activity
            android:name=".MyDocumentsActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="My Documents"
            android:theme="@style/Theme.XOne" >
        </activity>

        <!-- User Documents Activity -->
        <activity
            android:name=".UserDocumentsActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Documents"
            android:theme="@style/Theme.XOne" >
        </activity>

        <!-- No Document Found Activity -->
        <activity
            android:name=".NoDocumentFoundActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="No Document Found"
            android:theme="@style/Theme.XOne" >
        </activity>

        <!-- Add HomeActivity -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Home"
            android:theme="@style/Theme.XOne"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Add ChatActivity -->
        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:screenOrientation="portrait"
