<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".XOneApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="ArcheOne"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XOne"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <activity
            android:name=".ui.screens.SplashActivity"
            android:theme="@style/Theme.XOne.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>


        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.XOne">
        </activity>

        <!-- Add LoginActivity -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Login"
            android:theme="@style/Theme.XOne">
        </activity>

        <!-- OTP Verification Activity -->
        <activity
            android:name=".OtpVerificationActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="OTP Verification"
            android:theme="@style/Theme.XOne">
        </activity>

        <!-- My Documents Activity -->
        <activity
            android:name=".MyDocumentsActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="My Documents"
            android:theme="@style/Theme.XOne" >
        </activity>

        <!-- User Documents Activity -->
        <activity
            android:name=".UserDocumentsActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Documents"
            android:theme="@style/Theme.XOne" >
        </activity>

        <!-- Add HomeActivity -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Home"
            android:theme="@style/Theme.XOne"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Add ChatActivity -->
        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Chat Support"
            android:theme="@style/Theme.XOne" />

        <!-- Add WebViewActivity -->
        <activity
            android:name=".WebViewActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Document Viewer"
            android:theme="@style/Theme.XOne" />

        <!-- Add XConnectActivity -->
        <activity
            android:name=".XConnectActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="XConnect"
            android:theme="@style/Theme.XOne" />

        <!-- Update the SOSActivity declaration -->
        <activity
            android:name=".SOSActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="SOS"
            android:theme="@style/Theme.XOne" />

        <!-- Add SOSDetailActivity -->
        <activity
            android:name=".SOSDetailActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="SOS Details"
            android:theme="@style/Theme.XOne" />

        <!-- Add RaiseConcernActivity -->
        <activity
            android:name=".RaiseConcernActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="Raise a Concern"
            android:theme="@style/Theme.XOne" />

        <!-- Add ImageViewerActivity -->
        <activity
            android:name=".ImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.XOne" />

        <!-- Add TodoActivity -->
        <activity
            android:name=".TodoActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Todo"
            android:theme="@style/Theme.XOne" />

        <activity
            android:name=".ui.screens.CoreValuesActivity"
            android:exported="true"
            android:label="Core value"
            android:theme="@style/Theme.XOne" />

        <activity
            android:name=".VisionActivity"
            android:exported="true"
            android:label="Vision"
            android:theme="@style/Theme.XOne"  />

        <activity
            android:name=".ui.screens.IdeaVaultActivity"            android:exported="true"
            android:label="idea_vault"
            android:theme="@style/Theme.XOne"/>
            
        <activity
            android:name=".GreetingDetailActivity"
            android:exported="false"
            android:label="Greeting Detail"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.XOne"/>

        <activity
            android:name=".GlobalCelebrationDetailActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Global Celebration Detail"
            android:theme="@style/Theme.XOne" />

        <!-- Keep only this FileProvider at the end -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
